# 复制为 .env 后按需修改；不配置则使用下方默认值
# HTTP 服务端口
PORT=3210
# LLM（OpenAI 兼容协议；默认指向本机环境已配置的 StepFun）
LLM_BASE_URL=https://api.stepfun.com/step_plan/v1
LLM_API_KEY=
LLM_MODEL=step-5-preview
LLM_DECISION_MODEL=step-3.5-flash
# 推理模型的推理 token 也占用 max_tokens，配额过小会导致 content 为空
LLM_SPEAK_MAX_TOKENS=3000
LLM_DECISION_MAX_TOKENS=2000
# 调度参数（0 = 不设上限，默认无限额度）
MAX_AGENT_MESSAGES_PER_TURN=0
URGE_THRESHOLD=4
MAX_PER_AGENT_PER_TURN=0
MAX_HISTORY=30
DECISION_HISTORY=16
# 两条 Agent 消息之间的间隔（毫秒），让聊天节奏更自然；测试中设为 0
MESSAGE_DELAY_MS=900
# 房间名与数据目录（JSONL 持久化）
ROOM_TITLE=围炉夜话
DATA_DIR=./data
